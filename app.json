{
  "expo": {
    "name": "Music Ministry",
    "slug": "music-ministry",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/9b11f806-5921-4e61-9383-a3f7e125c18f.png",
      "resizeMode": "cover",
      "backgroundColor": "#1a2332"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lbkchano.musicministry",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "splash": {
        "image": "./assets/images/9b11f806-5921-4e61-9383-a3f7e125c18f.png",
        "resizeMode": "cover",
        "backgroundColor": "#1a2332"
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.lbkchano.musicministry",
      "versionCode": 11,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "splash": {
        "image": "./assets/images/9b11f806-5921-4e61-9383-a3f7e125c18f.png",
        "resizeMode": "cover",
        "backgroundColor": "#1a2332"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#1a2332",
        "androidMode": "default"
      }
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static",
            "cxxStandard": "c++20"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "react-native-edge-to-edge",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1a2332",
          "sounds": []
        }
      ]
    ],
    "scheme": "musicministry",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "69c9dc98-2c88-441d-be4d-4e0c9ba1af05"
      },
      "router": {
        "origin": false
      },
      "backendUrl": "https://nucffxkqp3vv9chpnxeb3a3fcnb99vdb.app.specular.dev"
    },
    "notification": {
      "icon": "./assets/notification-icon.png"
    }
  }
}