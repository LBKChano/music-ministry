{
  "expo": {
    "name": "Music Ministry",
    "slug": "music-ministry",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lbkchano.musicministry",
      "appleTeamId": "22ZT5M8WQ5",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Music Ministry does not use your location. This permission description is included because a notification library may reference location APIs.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.lbkchano.musicministry.onesignal",
          "group.com.lbkchano.musicministry.widgets"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.lbkchano.musicministry",
      "versionCode": 12,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "iPhoneDeploymentTarget": "16.0",
          "nseBundleIdentifier": "onesignalnse",
          "appGroupName": "group.com.lbkchano.musicministry.onesignal",
          "disableLocation": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#091C35",
          "android": {
            "image": "./assets/splash-mark.png",
            "imageWidth": 300,
            "resizeMode": "contain",
            "backgroundColor": "#091C35"
          },
          "ios": {
            "image": "./assets/splash-mark.png",
            "imageWidth": 300,
            "resizeMode": "contain",
            "backgroundColor": "#091C35"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static",
            "cxxStandard": "c++20"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "@bacons/apple-targets",
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "react-native-edge-to-edge"
    ],
    "scheme": "musicministry",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "69c9dc98-2c88-441d-be4d-4e0c9ba1af05"
      },
      "router": {
        "origin": false
      },
      "backendUrl": "https://nucffxkqp3vv9chpnxeb3a3fcnb99vdb.app.specular.dev",
      "oneSignalAppId": "d22a0591-70f3-4c9b-b006-00beed197e85"
    }
  }
}
